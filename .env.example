# Vercel 서버리스 환경변수 (Vercel > 프로젝트 > Settings > Environment Variables)

# 필수: 노션 통합 토큰 (Integration secret) — 절대 어플에 넣지 않는다
NOTION_API_KEY=ntn_xxxxxxxxxxxxxxxxxxxx

# 공부 타이머 기록 DB
NOTION_DATABASE_ID=9bdf7b3b-632f-49bb-84a9-e3f4c7791c1c

# 단어장 DB
NOTION_VOCAB_DATABASE_ID=0a1b9ad8-da56-4bf5-b448-28d98b555ace

# 선택: 최신 노션 구조(data source)를 사용 중이라면 data source ID도 설정한다.
#   공부 기록 data source: f6380b51-fcc1-48f8-8654-5aa2b5802815
#   단어장 data source:    0a1b9ad8-da56-4bf5-b448-28d98b555ace
# 설정하면 data source 엔드포인트를 우선 사용한다. (단어장은 미설정 시 단어장 DB ID로 동작)
NOTION_DATA_SOURCE_ID=f6380b51-fcc1-48f8-8654-5aa2b5802815
NOTION_VOCAB_DATA_SOURCE_ID=0a1b9ad8-da56-4bf5-b448-28d98b555ace

# 선택: 대시보드 '오늘' 기준 타임존 (기본 Asia/Seoul)
DASHBOARD_TIMEZONE=Asia/Seoul

# 한자 음독/훈독 SRS 리셋 API 인증 (27차)
# Vercel 환경변수에 반드시 등록해야 함 (settings > Environment Variables)
HERMES_SECRET=a2a86ac4dca9fc52612ec3df2a85223a64d1bf1a
