{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "version": 2,
  "functions": {
    "api/*.js": {
      "maxDuration": 10,
      "runtime": "nodejs20.x"
    }
  },
  "rewrites": [
    { "source": "/dashboard", "destination": "/api/dashboard" },
    { "source": "/sync", "destination": "/api/sync" },
    { "source": "/vocab", "destination": "/api/vocab" }
  ]
}
